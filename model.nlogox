          <value value="&quot;Rooms&quot;"></value>
          <value value="&quot;Spiral&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="random-obstacle-density">
          <value value="20"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="alpha">
          <value value="10"></value>
          <value value="30"></value>
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="beta">
          <value value="5"></value>
          <value value="10"></value>
          <value value="20"></value>
