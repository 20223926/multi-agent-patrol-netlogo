    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="434" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="434" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <plot x="830" autoPlotX="true" yMax="200.0" autoPlotY="true" yAxis="Idleness" y="20" xMin="0.0" height="370" legend="true" xMax="200.0" yMin="0.0" width="495" xAxis="Ticks" display="IGI - IWI">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="IGI" color="-7500403" legend="true">
        <setup>plot IGI</setup>
        <update>plot IGI</update>
      </pen>
      <pen interval="1.0" mode="0" display="IWI" color="-2674135" legend="true">
