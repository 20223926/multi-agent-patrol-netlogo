  <experiments>
    <experiment name="EVAP" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>IGI</metric>
        <metric>IWI</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="proba-continuer">
          <value value="0"></value>
          <value value="0.25"></value>
          <value value="0.5"></value>
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="nb-agents">
          <value value="1"></value>
          <value value="4"></value>
          <value value="16"></value>
          <value value="32"></value>
          <value value="64"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="qmax">
          <value value="50"></value>
          <value value="100"></value>
          <value value="150"></value>
          <value value="300"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="rho">
          <value value="0.001"></value>
          <value value="0.01"></value>
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="algo-mode">
          <value value="&quot;EVAP&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="map-mode">
          <value value="&quot;Blank&quot;"></value>
          <value value="&quot;Random Obstacles&quot;"></value>
          <value value="&quot;Rooms&quot;"></value>
          <value value="&quot;Spiral&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="random-obstacle-density">
          <value value="20"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="CLInG" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>IGI</metric>
        <metric>IWI</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="nb-agents">
          <value value="1"></value>
          <value value="4"></value>
          <value value="16"></value>
          <value value="32"></value>
          <value value="64"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="algo-mode">
          <value value="&quot;CLInG&quot;"></value>
        </enumeratedValueSet>
